# Application Settings
ENVIRONMENT=development
PROJECT_NAME="GuardLLM Security Gateway"
API_V1_STR=/api/v1
DEBUG=true

# Security & CORS (JSON format or comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini Provider (Fase 4)
GEMINI_API_KEY=your_gemini_api_key_here
